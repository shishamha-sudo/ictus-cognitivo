rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function isAdmin() {
      return signedIn()
        && !isAnonymous()
        && request.auth.token.email != null
        && request.auth.token.email == "shishamha@gmail.com";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && (
          (isAdmin() && request.resource.data.role == "admin")
          ||
          (!isAdmin() && request.resource.data.role == "user")
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
        );

      allow delete: if isAdmin();

      match /results/{resultId} {
        allow read, create, update, delete: if isOwner(uid) || isAdmin();
      }
    }

    match /usageLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (
          (isAnonymous() && request.resource.data.email == "")
          ||
          (!isAnonymous() && request.resource.data.email == request.auth.token.email)
        );
      allow update, delete: if false;
    }
  }
}
